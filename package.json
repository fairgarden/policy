  },
  "devDependencies": {
    "@fairgarden/distribution": "^0.1.0-alpha.2",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-orm": "^0.45.3",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45"
  },
